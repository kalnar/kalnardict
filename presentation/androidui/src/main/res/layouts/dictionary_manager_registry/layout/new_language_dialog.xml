<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:paddingTop="40dp"
    android:paddingBottom="50dp"
    android:paddingStart="15dp"
    android:paddingEnd="15dp"
    android:elevation="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="280dp"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/add_new_language_dialog_title"
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical|center"
            android:text="@string/add_new_language_dialog_title_text"
            android:textColor="@color/white"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/add_new_language_dialog_id_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:gravity="center"
            android:text="@string/new_language_code_tag"
            app:layout_constraintBottom_toBottomOf="@id/add_new_language_dialog_id_edit_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@id/add_new_language_dialog_tag_end_barrier"
            app:layout_constraintTop_toTopOf="@id/add_new_language_dialog_id_edit_text" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/add_new_language_dialog_id_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="@dimen/title_description_spacing"
            android:layout_marginEnd="30dp"
            app:layout_constraintLeft_toRightOf="@id/add_new_language_dialog_tag_end_barrier"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/add_new_language_dialog_title" />

        <TextView
            android:id="@+id/add_new_language_dialog_description_tag"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:text="@string/new_language_description_tag"
            app:layout_constraintBottom_toBottomOf="@id/add_new_language_dialog_description_edit_text"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@id/add_new_language_dialog_description_edit_text" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/add_new_language_dialog_description_edit_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="@dimen/title_description_spacing"
            android:layout_marginEnd="30dp"
            app:layout_constraintLeft_toRightOf="@id/add_new_language_dialog_tag_end_barrier"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/add_new_language_dialog_id_edit_text" />


        <com.google.android.material.button.MaterialButton
            android:id="@+id/add_new_language_dialog_button"
            style="@style/Widget.AppCompat.Button.Colored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingHorizontal="30dp"
            android:text="@string/language_registry_dialog_cta"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/add_new_language_dialog_description_edit_text" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/add_new_language_dialog_tag_end_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="end"
            app:constraint_referenced_ids="add_new_language_dialog_id_tag,add_new_language_dialog_description_tag" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
