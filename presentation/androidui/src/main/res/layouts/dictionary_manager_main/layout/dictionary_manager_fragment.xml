<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@drawable/secondary_primary_gradient_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/no_dictionary_message_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="30dp"
        app:layout_constraintBottom_toTopOf="@id/list_recycler_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed">

        <TextView
            android:id="@+id/dictionary_manager_no_dictionary_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/dictionary_manager_title"
            android:textColor="@color/message_white"
            android:textSize="@dimen/message_big_title"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/dictionary_manager_no_dictionary_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/message_description_horizontal_margin"
            android:layout_marginTop="@dimen/title_description_spacing"
            android:layout_marginEnd="@dimen/message_description_horizontal_margin"
            android:gravity="center"
            android:paddingBottom="@dimen/after_description_spacing"
            android:text="@string/dictionary_manager_no_dictionary_description"
            android:textColor="@color/message_white"
            android:textSize="@dimen/message_description_text_size"
            app:layout_constraintTop_toBottomOf="@id/dictionary_manager_no_dictionary_title_view" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_recycler_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/no_dictionary_message_view"
        tools:itemCount="2"
        tools:listitem="@layout/dictionary_manager_manageable_dictionary_item_view">

    </androidx.recyclerview.widget.RecyclerView>
</androidx.constraintlayout.widget.ConstraintLayout>