<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimaryDark"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/dictionary_manager_no_dictionary_title_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/message_white"
            android:textSize="@dimen/message_big_title"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="@tools:sample/lorem" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/message_white"
            android:layout_marginTop="@dimen/title_description_spacing"
            android:paddingBottom="@dimen/after_description_spacing"
            android:textSize="@dimen/message_description_text_size"
            app:layout_constraintTop_toBottomOf="@id/dictionary_manager_no_dictionary_title_view"
            tools:text="@tools:sample/lorem[22]" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
